# Copy to backend/.env and fill in the values. Never commit .env to git.
#
# Get the Client ID and secret from the Google Cloud Console
# (Google Auth Platform -> Clients -> Web application).
# Share the secret privately, not in a public channel.
OIDC_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
OIDC_GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# Must match "Authorized redirect URI" in the Google Cloud Console.
OIDC_GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback/

FRONTEND_URL=http://localhost:5173
