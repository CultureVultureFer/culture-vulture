# Kopiraj u backend/.env i popuni. .env NIKAD ne ide u git.
#
# Client ID i secret dobiješ u Google Cloud Consoleu
# (Google Auth Platform -> Clients -> Web application).
# Secret dijelite privatno, ne u javnom kanalu.
OIDC_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
OIDC_GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# Mora biti identično "Authorized redirect URI" u Google Cloud Consoleu.
OIDC_GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback/

FRONTEND_URL=http://localhost:5173
