# syntax=docker/dockerfile:1

# Build stage: install dependencies and bundle the static frontend assets.
FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VITE_BACKEND_URL=/api
ENV VITE_BACKEND_URL=${VITE_BACKEND_URL}

RUN npm run build

# Production stage: serve static assets and reverse-proxy /api with Nginx.
FROM nginx:alpine AS production

ENV PORT=80
# Backend origin (without trailing slash) to which /api/ requests are proxied.
ENV BACKEND_URL=http://backend:8000

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf.template /etc/nginx/templates/default.conf.template

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
